---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="block group/link">
    <button
        class:list={`
            w-full
            h-9
            rounded-xl
            bg-transparent
            hover:bg-[var(--btn-plain-bg-hover)]
            active:scale-[0.98]
            transition-all
            px-2.5
            text-sm
            font-medium
            text-[var(--secondary-foreground)]
            group-hover/link:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between relative">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition px-2.5 h-5.5 min-w-[1.75rem] rounded-full text-xs font-mono tabular-nums font-medium
                    text-[var(--muted-foreground)] group-hover/link:text-[var(--primary)]
                    bg-black/[0.04] dark:bg-white/[0.05] border border-[var(--card-border)]
                    flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
