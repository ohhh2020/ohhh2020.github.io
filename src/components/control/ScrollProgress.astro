<!-- 顶部极光流光阅读进度条 -->
<div id="scroll-progress-bar"
     class="fixed top-0 left-0 h-[3px] z-[99999] pointer-events-none transition-all duration-75"
     style="width: 0%; background: linear-gradient(90deg, var(--primary), #00d2ff, #a855f7); box-shadow: 0 0 10px var(--primary), 0 0 4px #00d2ff;">
</div>

<script>
    function updateScrollProgress() {
        const bar = document.getElementById("scroll-progress-bar");
        if (!bar) return;

        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;

        if (scrollHeight <= 0) {
            bar.style.width = "0%";
            return;
        }

        const progress = Math.min(100, Math.max(0, (scrollTop / scrollHeight) * 100));
        bar.style.width = `${progress}%`;
    }

    window.addEventListener("scroll", updateScrollProgress, { passive: true });
    window.addEventListener("resize", updateScrollProgress);

    // Swup 页面切换时重新校准
    // @ts-ignore
    window.swup?.hooks?.on("page:view", () => {
        updateScrollProgress();
    });
</script>
