---
import MainGridLayout from "../layouts/MainGridLayout.astro";

const photos = [
    {
        title: "超清壁纸 3840x2160",
        desc: "4K 极客光影",
        src: "/pictures/images/12/3840x2160.jpg"
    },
    {
        title: "超清全景 5536x3008",
        desc: "5K 浩瀚天际",
        src: "/pictures/images/12/5536x3008.jpg"
    },
    {
        title: "竖屏壁纸 978x2160",
        desc: "高解析光感特写",
        src: "/pictures/images/12/978x2160.jpg"
    },
    {
        title: "精选缩略 000",
        desc: "画廊精选",
        src: "/pictures/images/12/000.jpg"
    }
];
---

<MainGridLayout title="画廊相册" description="生的精选画廊相册">
    <div class="card-base p-6 md:p-8 rounded-2xl mb-6 onload-animation">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-1.5 h-6 bg-[var(--primary)] rounded-full"></div>
            <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90">精选相册 / Gallery</h1>
        </div>
        <p class="text-neutral-500 dark:text-neutral-400 text-sm">
            记录生活瞬间、精美 4K 壁纸与视觉收藏。点击图片可全屏沉浸式预览。
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mb-8 custom-md">
        {photos.map((photo) => (
            <div class="card-base group overflow-hidden rounded-2xl relative shadow-md hover:shadow-xl transition-all duration-300 onload-animation">
                <div class="overflow-hidden aspect-video bg-neutral-900/10 dark:bg-neutral-800/50 flex items-center justify-center">
                    <img
                        src={photo.src}
                        alt={photo.title}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 cursor-pointer"
                    />
                </div>
                <div class="p-4 bg-[var(--card-bg)]">
                    <div class="font-bold text-base text-black/85 dark:text-white/85 group-hover:text-[var(--primary)] transition">
                        {photo.title}
                    </div>
                    <div class="text-xs text-neutral-400 mt-1">
                        {photo.desc}
                    </div>
                </div>
            </div>
        ))}
    </div>
</MainGridLayout>
