---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { musicConfig } from "../config";

const playlistId = musicConfig.neteasePlaylistId || "2971528746";
---

<MainGridLayout title="音乐空间" description="生的专属音乐空间与网易云曲库">
    <!-- 音乐主卡片 -->
    <div class="card-base p-6 md:p-8 rounded-2xl mb-6 onload-animation">
        <div class="flex flex-col md:flex-row items-center gap-6">
            <!-- 唱片机金属视效 -->
            <div class="relative w-28 h-28 md:w-36 md:h-36 rounded-full bg-neutral-950 border-4 border-neutral-800 shadow-2xl flex items-center justify-center shrink-0">
                <div class="absolute inset-2 rounded-full border border-neutral-800/80 pointer-events-none"></div>
                <div class="absolute inset-5 rounded-full border border-neutral-800/60 pointer-events-none"></div>
                <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-[var(--primary)] to-cyan-500 flex items-center justify-center shadow-lg animate-spin-slow">
                    <div class="w-3.5 h-3.5 rounded-full bg-neutral-950 border-2 border-white/80"></div>
                </div>
            </div>

            <!-- 歌单信息 -->
            <div class="flex-1 text-center md:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-semibold mb-2">
                    <span class="w-2 h-2 rounded-full bg-[var(--primary)] animate-ping"></span>
                    网易云官方原版直连 · 6,000+ 首曲库
                </div>
                <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90 mb-2">
                    生的私人音乐宇宙
                </h1>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                    已直连你的网易云官方曲库，调用网易云原生音频引擎，支持完整畅听你的 VIP 歌曲与红心收藏。
                </p>
            </div>
        </div>
    </div>

    <!-- 网易云官方播放器区域 (无版权/VIP报错，官方原汁原味) -->
    <div class="card-base p-6 md:p-8 rounded-2xl mb-6 onload-animation">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-black/5 dark:border-white/10">
            <div class="flex items-center gap-2 font-bold text-base md:text-lg text-black/85 dark:text-white/85">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[var(--primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
                <span>网易云官方原版播放器</span>
            </div>
            <a
                target="_blank"
                href={`https://music.163.com/#/playlist?id=${playlistId}`}
                class="text-xs text-[var(--primary)] hover:underline flex items-center gap-1 font-medium"
            >
                在网易云 App 中打开
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
            </a>
        </div>

        <div class="w-full rounded-2xl overflow-hidden shadow-sm border border-black/5 dark:border-white/10 bg-white dark:bg-neutral-900">
            <iframe
                title="网易云官方原版播放器"
                width="100%"
                height="480"
                src={`https://music.163.com/outchain/player?type=0&id=${playlistId}&auto=0&height=430`}
                class="w-full border-0"
            ></iframe>
        </div>
    </div>

    <!-- 定制精选直链音源库专区 -->
    <div class="card-base p-6 md:p-8 rounded-2xl mb-8 onload-animation">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-1.5 h-5 bg-[var(--primary)] rounded-full"></div>
            <h2 class="text-lg md:text-xl font-bold text-black/90 dark:text-white/90">
                专属精选直链音源库（待收录）
            </h2>
        </div>
        <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4">
            随时把你想听的具体歌名（例如：《晴天》、《夜曲》、《漠河舞厅》等）告诉我，我会为你逐一解析出稳定、高品质的免 VIP 专属直链，定制成免客户端、即开即听的专属歌曲列表！
        </p>

        <div class="p-4 rounded-xl bg-neutral-50 dark:bg-neutral-800/40 border border-dashed border-black/10 dark:border-white/10 text-center">
            <div class="text-xs text-neutral-400 py-2">
                🎵 还没有添加定制直链歌曲。在对话框告诉我你的歌名，马上为你解析收录！
            </div>
        </div>
    </div>
</MainGridLayout>

<style is:global>
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 12s linear infinite;
    }
</style>
