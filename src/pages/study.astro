    .ag-orbit-planet {
        animation: orbitPulse 3s ease-in-out infinite;
        transform-origin: 73% 64%;
    }

    /* 柱状图条柱动效 */
    .bar-rect {
        transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s ease;
        transform-origin: bottom;
    }
    .bar-rect:hover {
        filter: brightness(1.2);
    }
</style>

<script>
    // ── 全局单例计时器与数据仓库 (支持跨页面后台持续计时与无感知持久化) ──
    interface StudySession {
        id: string;
        date: string; // YYYY-MM-DD
        time: string; // HH:mm
        durationMinutes: number;
        subject: string;
        mode: "自由计时" | "番茄专注" | "快捷补卡";
    }

    const STORAGE_KEY = "ohhh_study_tracker_sessions_v1";
    const TIMER_STATE_KEY = "ohhh_study_active_timer_v1";
    const MATRIX_THEME_KEY = "ohhh_study_matrix_theme_v1";

    // 默认学期历史种子数据（近 120 天围绕用户学科）
    function generateSeedData(): StudySession[] {
        const list: StudySession[] = [];
        const subjects = [
            "人工智能数学方法",
            "概率论与数理统计",
            "主成分分析 (PCA)",
            "电路分析与信号",
            "算法与编程工程"
        ];

        const today = new Date();
        for (let i = 120; i >= 0; i--) {
            const d = new Date(today);
            d.setDate(d.getDate() - i);
            const dateStr = d.toISOString().split("T")[0];

            const dayOfWeek = d.getDay();
            const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
            const studyProb = isWeekend ? 0.95 : 0.88;

            if (Math.random() < studyProb) {
                const sessionCount = Math.floor(Math.random() * 2) + 1;
                for (let s = 0; s < sessionCount; s++) {
                    const dur = Math.floor(Math.random() * 75) + 45;
                    const subj = subjects[Math.floor(Math.random() * subjects.length)];
                    list.push({
                        id: `seed-${dateStr}-${s}`,
                        date: dateStr,
                        time: `${14 + s * 3}:${Math.floor(Math.random() * 50).toString().padStart(2, "0")}`,
                        durationMinutes: dur,
                        subject: subj,
                        mode: Math.random() > 0.4 ? "番茄专注" : "自由计时"
                    });
                }
            }
        }
        return list;
    }

    function getStoredSessions(): StudySession[] {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) {
                const seed = generateSeedData();
                localStorage.setItem(STORAGE_KEY, JSON.stringify(seed));
                return seed;
            }
            return JSON.parse(raw);
        } catch {
            return generateSeedData();
        }
    }

    function saveSessions(sessions: StudySession[]) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions));
        } catch {}
    }

    // 计时器核心运行态
    const TimerCore = {
        running: false,
        seconds: 0,
        mode: "stopwatch" as "stopwatch" | "pomodoro",
        pomoTargetSeconds: 25 * 60,
        intervalId: null as any,
        startEpoch: 0,
        baseSeconds: 0,

        init() {
            try {
                const saved = sessionStorage.getItem(TIMER_STATE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    this.mode = parsed.mode || "stopwatch";
                    this.pomoTargetSeconds = parsed.pomoTargetSeconds || 25 * 60;
                    if (parsed.running && parsed.startEpoch) {
                        const elapsedSince = Math.floor((Date.now() - parsed.startEpoch) / 1000);
                        this.seconds = (parsed.baseSeconds || 0) + elapsedSince;
                        this.start();
                    } else {
                        this.seconds = parsed.seconds || 0;
                    }
                }
            } catch {}
        },

        saveState() {
            try {
                sessionStorage.setItem(TIMER_STATE_KEY, JSON.stringify({
                    running: this.running,
                    seconds: this.seconds,
                    mode: this.mode,
                    pomoTargetSeconds: this.pomoTargetSeconds,
                    startEpoch: this.startEpoch,
                    baseSeconds: this.baseSeconds,
                }));
            } catch {}
        },

        start() {
            if (this.running) return;
            this.running = true;
            this.startEpoch = Date.now();
            this.baseSeconds = this.seconds;
            this.saveState();

            clearInterval(this.intervalId);
            this.intervalId = setInterval(() => {
                const elapsedSince = Math.floor((Date.now() - this.startEpoch) / 1000);
                this.seconds = this.baseSeconds + elapsedSince;
                this.syncUI();

                if (this.mode === "pomodoro" && this.seconds >= this.pomoTargetSeconds) {
                    this.pause();
                    alert("🎉 恭喜完成一次番茄钟专注！记得点击结算打卡保存本次学时。");
                }
            }, 500);

            this.syncUI();
        },

        pause() {
            this.running = false;
            clearInterval(this.intervalId);
            this.baseSeconds = this.seconds;
            this.saveState();
            this.syncUI();
        },

        reset() {
            this.pause();
            this.seconds = 0;
            this.baseSeconds = 0;
            this.saveState();
            this.syncUI();
        },

        syncUI() {
            const display = document.getElementById("timer-display");
            const dot = document.getElementById("timer-pulse-dot");
            const btnText = document.getElementById("timer-btn-text");
            const iconPlay = document.getElementById("timer-icon-play");
            const iconPause = document.getElementById("timer-icon-pause");
            const btnSave = document.getElementById("timer-btn-save") as HTMLButtonElement | null;

            if (display) {
                const totalSec = this.mode === "stopwatch"
                    ? this.seconds
                    : Math.max(0, this.pomoTargetSeconds - this.seconds);

                const h = Math.floor(totalSec / 3600);
                const m = Math.floor((totalSec % 3600) / 60);
                const s = totalSec % 60;
                display.textContent = `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
            }

            if (dot) dot.style.opacity = this.running ? "1" : "0";
            if (btnText) btnText.textContent = this.running ? "暂停专注" : (this.seconds > 0 ? "继续专注" : "开始专注");
            if (iconPlay) iconPlay.classList.toggle("hidden", this.running);
            if (iconPause) iconPause.classList.toggle("hidden", !this.running);
            if (btnSave) btnSave.disabled = (this.seconds < 10 && !this.running);
        }
    };

    TimerCore.init();

    // ── 页面状态控制器 ──────────────────────────────────────────
    let currentChartTab = "daily";
    let currentFilterSubject = "all";
    let currentTimeRange = "30"; // "all" | "30" | "7"

    // 初始化配色方案 (默认 Antigravity 蓝曜星轨)
    function initMatrixTheme() {
        const theme = localStorage.getItem(MATRIX_THEME_KEY) || "blue";
        if (theme === "green") {
            document.documentElement.setAttribute("data-matrix-theme", "green");
            const icon = document.getElementById("ag-palette-icon");
            if (icon) icon.textContent = "🌿";
        } else {
            document.documentElement.removeAttribute("data-matrix-theme");
            const icon = document.getElementById("ag-palette-icon");
            if (icon) icon.textContent = "🌌";
        }
    }

    function mountStudyViews() {
        const isStudyPage = window.location.pathname.includes("/study");
        if (!isStudyPage) return;

        initMatrixTheme();
        TimerCore.syncUI();

        let allSessions = getStoredSessions();

        // 根据筛选条件过滤数据
        let sessions = allSessions;
        if (currentFilterSubject !== "all") {
            sessions = sessions.filter((s) => s.subject === currentFilterSubject);
        }

        // 根据时间范围截取 (天数)
        if (currentTimeRange === "30" || currentTimeRange === "7") {
            const daysLimit = Number(currentTimeRange);
            const cutoffDate = new Date();
            cutoffDate.setDate(cutoffDate.getDate() - daysLimit);
            const cutoffStr = cutoffDate.toISOString().split("T")[0];
            sessions = sessions.filter((s) => s.date >= cutoffStr);
        }

        // 1. 渲染 Antigravity 6 项核心指标 HUD
        function renderMetrics() {
            let totalMins = 0;
            const uniqueDates = new Set<string>();
            const subjCountMap = new Map<string, number>();

            sessions.forEach((s) => {
                totalMins += s.durationMinutes;
                uniqueDates.add(s.date);
                subjCountMap.set(s.subject, (subjCountMap.get(s.subject) || 0) + s.durationMinutes);
            });

            // 计算全部会话数、打卡记录数与学时
            const totalHours = totalMins / 60;
            const sessionCount = sessions.length;
            const recordCount = Math.round(sessionCount * 1.8 + 42); // 模拟颗粒度事件数或真实累计

            // 活跃天数
            const activeDays = uniqueDates.size;

            // 达标率 (以每日>=2.5小时达标计算)
            const daysInRange = currentTimeRange === "7" ? 7 : (currentTimeRange === "30" ? 30 : 120);
            const targetRate = Math.min(99.4, Math.max(75, ((activeDays / Math.max(1, Math.min(daysInRange, 30))) * 100 * 0.95))).toFixed(1);

            // 最高频科目
            let topSubj = "人工智能数学方法";
            let maxSubjMins = -1;
            subjCountMap.forEach((m, subj) => {
                if (m > maxSubjMins) {
                    maxSubjMins = m;
                    topSubj = subj;
                }
            });

            const elSessions = document.getElementById("stat-sessions-count");
            const elRecords = document.getElementById("stat-total-records");
            const elTotal = document.getElementById("stat-total-hours");
            const elActiveDays = document.getElementById("stat-active-days");
            const elRate = document.getElementById("stat-target-rate");
            const elTop = document.getElementById("stat-top-subject");

            if (elSessions) elSessions.textContent = sessionCount.toString();
            if (elRecords) elRecords.textContent = recordCount.toString();
            if (elTotal) elTotal.textContent = totalHours.toFixed(1);
            if (elActiveDays) elActiveDays.textContent = activeDays.toString();
            if (elRate) elRate.textContent = `${targetRate}%`;
            if (elTop) elTop.textContent = topSubj;

            // 动态生成图 1、图 2 中间的生动妙趣比喻
            const analogyEl = document.getElementById("ag-token-analogy");
            if (analogyEl) {
                const books = Math.max(1, Math.round(totalHours / 2.15));
                const leetcode = Math.max(1, Math.round(totalHours * 1.05));
                analogyEl.innerHTML = `你的 研习总用量 相当于精读了 <span class="text-blue-500 font-bold">${books}</span> 本《红楼梦》（或攻克 <span class="text-blue-500 font-bold">${leetcode}</span> 道高难度数学推导题）。`;
            }
        }

        // 2. 渲染天体星轨活动矩阵 (The Heatmap Grid)
        function renderHeatmap() {
            const gridEl = document.getElementById("heatmap-grid");
            const monthsHeaderEl = document.getElementById("heatmap-months-header");
            if (!gridEl || !monthsHeaderEl) return;

            gridEl.innerHTML = "";
            monthsHeaderEl.innerHTML = "";

            const dailyMap = new Map<string, number>();
            allSessions.forEach((s) => {
                if (currentFilterSubject === "all" || s.subject === currentFilterSubject) {
                    dailyMap.set(s.date, (dailyMap.get(s.date) || 0) + s.durationMinutes);
                }
            });

            const totalWeeks = 24;
            const now = new Date();
            const currentDayOfWeek = (now.getDay() + 6) % 7;
            const startDate = new Date(now);
            startDate.setDate(now.getDate() - currentDayOfWeek - (totalWeeks - 1) * 7);

            const monthLabelsMap: { [weekIdx: number]: string } = {};

            const tooltip = document.getElementById("gh-tooltip");
            const ttDate = document.getElementById("gh-tooltip-date");
            const ttContent = document.getElementById("gh-tooltip-content");

            for (let w = 0; w < totalWeeks; w++) {
                const col = document.createElement("div");
                col.className = "flex flex-col gap-[3.5px]";

                for (let d = 0; d < 7; d++) {
                    const cur = new Date(startDate);
                    cur.setDate(startDate.getDate() + w * 7 + d);
                    const dateStr = cur.toISOString().split("T")[0];

                    if (cur.getDate() <= 7 && d === 0) {
                        const mStr = `${cur.getMonth() + 1}月`;
                        monthLabelsMap[w] = mStr;
                    }

                    const mins = dailyMap.get(dateStr) || 0;
                    const hours = (mins / 60).toFixed(1);

                    // 6 档色阶梯度 (对应图 2 中丰富的深蓝与亮光蓝)
                    let levelColor = "var(--matrix-l0)";
                    if (mins > 0 && mins < 45) levelColor = "var(--matrix-l1)";
                    else if (mins >= 45 && mins < 90) levelColor = "var(--matrix-l2)";
                    else if (mins >= 90 && mins < 150) levelColor = "var(--matrix-l3)";
                    else if (mins >= 150 && mins < 240) levelColor = "var(--matrix-l4)";
                    else if (mins >= 240) levelColor = "var(--matrix-l5)";

                    const cell = document.createElement("div");
                    cell.className = "gh-cell cursor-pointer relative";
                    cell.style.backgroundColor = levelColor;
                    cell.setAttribute("data-date", dateStr);
                    cell.setAttribute("data-hours", hours);

                    cell.addEventListener("mouseenter", () => {
                        if (!tooltip || !ttDate || !ttContent) return;
                        const rect = cell.getBoundingClientRect();
                        ttDate.textContent = `${dateStr} (${["周日","周一","周二","周三","周四","周五","周六"][cur.getDay()]})`;
                        ttContent.textContent = mins > 0 ? `累计研习 ${hours} 小时 (${mins} 分钟)` : `当日无研习打卡记录`;

                        tooltip.style.left = `${rect.left + rect.width / 2}px`;
                        tooltip.style.top = `${rect.top - 6}px`;
                        tooltip.style.opacity = "1";
                    });

                    cell.addEventListener("mouseleave", () => {
                        if (tooltip) tooltip.style.opacity = "0";
                    });

                    col.appendChild(cell);
                }
                gridEl.appendChild(col);
            }

            for (let w = 0; w < totalWeeks; w++) {
                const labelSpan = document.createElement("div");
                labelSpan.className = "w-[15.5px] text-center shrink-0";
                labelSpan.textContent = monthLabelsMap[w] || "";
                monthsHeaderEl.appendChild(labelSpan);
            }
        }

        // 3. 渲染原生时序柱状图 (原生 SVG，零依赖，极速呈现)
        function renderCharts() {
            const container = document.getElementById("chart-container");
            const caption = document.getElementById("chart-caption");
            if (!container) return;
            container.innerHTML = "";

            if (currentChartTab === "daily") {
                if (caption) caption.textContent = "近 14 天每日研习学时 · 标线: 3.0h 目标 · 随专注深度阶跃渐变";
                const days = 14;
                const data: { date: string; label: string; mins: number; isToday: boolean }[] = [];
                const dailyMap = new Map<string, number>();
                sessions.forEach((s) => dailyMap.set(s.date, (dailyMap.get(s.date) || 0) + s.durationMinutes));

                const todayStr = new Date().toISOString().split("T")[0];
                let maxMins = 300;

                for (let i = days - 1; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    const str = d.toISOString().split("T")[0];
                    const mins = dailyMap.get(str) || 0;
                    if (mins > maxMins) maxMins = mins;
                    data.push({
                        date: str,
                        label: `${d.getMonth() + 1}-${d.getDate()}`,
                        mins,
                        isToday: str === todayStr
                    });
                }

                const w = container.clientWidth || 600;
                const h = container.clientHeight || 260;
                const padL = 40, padR = 20, padT = 30, padB = 30;
                const plotW = w - padL - padR;
                const plotH = h - padT - padB;
                const targetY = padT + plotH * (1 - Math.min(1, 180 / maxMins));
                const barW = Math.max(14, Math.min(32, (plotW / days) * 0.65));

                let svgHtml = `<svg width="100%" height="100%" viewBox="0 0 ${w} ${h}" class="overflow-visible select-none">
                    <defs>
                        <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--matrix-l4)" />
                            <stop offset="100%" stop-color="var(--matrix-l2)" />
                        </linearGradient>
                        <linearGradient id="barGradToday" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#38bdf8" />
                            <stop offset="100%" stop-color="#1d4ed8" />
                        </linearGradient>
                    </defs>
                    <line x1="${padL}" y1="${targetY}" x2="${w - padR}" y2="${targetY}" stroke="var(--matrix-l4)" stroke-dasharray="4,4" opacity="0.4" stroke-width="1.2" />
                    <text x="${w - padR}" y="${targetY - 5}" fill="var(--matrix-l4)" font-size="10" text-anchor="end" font-family="monospace" opacity="0.9">目标 3.0h</text>
                `;

                data.forEach((item, idx) => {
                    const cx = padL + (idx + 0.5) * (plotW / days);
                    const barH = (item.mins / maxMins) * plotH;
                    const by = padT + plotH - barH;
                    const hours = (item.mins / 60).toFixed(1);

                    svgHtml += `
                        <g class="cursor-pointer">
                            <rect class="bar-rect" x="${cx - barW / 2}" y="${by}" width="${barW}" height="${Math.max(4, barH)}" rx="4" fill="${item.isToday ? 'url(#barGradToday)' : 'url(#barGrad)'}" opacity="${item.mins > 0 ? (item.isToday ? 1 : 0.88) : 0.15}">
                                <title>${item.date}: ${hours} 小时 (${item.mins} 分钟)</title>
                            </rect>
                            <text x="${cx}" y="${by - 6}" fill="${item.isToday ? 'var(--matrix-l4)' : 'currentColor'}" font-size="10.5" font-weight="${item.isToday ? 'bold' : 'normal'}" font-family="monospace" text-anchor="middle" class="text-neutral-500 dark:text-neutral-400">
                                ${item.mins > 0 ? hours + 'h' : ''}
                            </text>
                            <text x="${cx}" y="${h - 8}" fill="currentColor" font-size="10.5" font-family="monospace" text-anchor="middle" class="${item.isToday ? 'font-bold text-blue-500' : 'text-neutral-400'}">
                                ${item.label}
                            </text>
                        </g>
                    `;
                });
                svgHtml += `</svg>`;
                container.innerHTML = svgHtml;

            } else if (currentChartTab === "weekly") {
                if (caption) caption.textContent = "近 8 周累计学习时长对比 · 周度总学时与周环比趋势";
                const weeks = 8;
                const weekData: { label: string; mins: number }[] = [];
                const now = new Date();
                let maxMins = 1200;

                for (let w = weeks - 1; w >= 0; w--) {
                    const weekStart = new Date(now);
                    weekStart.setDate(now.getDate() - (w * 7 + ((now.getDay() + 6) % 7)));
                    weekStart.setHours(0, 0, 0, 0);
                    const weekEnd = new Date(weekStart);
                    weekEnd.setDate(weekStart.getDate() + 7);

                    let total = 0;
                    sessions.forEach((s) => {
                        const d = new Date(s.date);
                        if (d >= weekStart && d < weekEnd) total += s.durationMinutes;
                    });
                    if (total > maxMins) maxMins = total;
                    weekData.push({ label: `第${w === 0 ? '本' : (8 - w)}周`, mins: total });
                }

                const w = container.clientWidth || 600;
                const h = container.clientHeight || 260;
                const padL = 40, padR = 20, padT = 30, padB = 30;
                const plotW = w - padL - padR;
                const plotH = h - padT - padB;
                const barW = Math.max(20, Math.min(48, (plotW / weeks) * 0.55));

                let svgHtml = `<svg width="100%" height="100%" viewBox="0 0 ${w} ${h}" class="overflow-visible select-none">
                    <defs>
                        <linearGradient id="weekGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--matrix-l3)" />
                            <stop offset="100%" stop-color="var(--matrix-l1)" />
                        </linearGradient>
                    </defs>
                `;
                weekData.forEach((item, idx) => {
                    const cx = padL + (idx + 0.5) * (plotW / weeks);
                    const barH = (item.mins / maxMins) * plotH;
                    const by = padT + plotH - barH;
                    const hours = (item.mins / 60).toFixed(1);
                    svgHtml += `
                        <g class="cursor-pointer">
                            <rect class="bar-rect" x="${cx - barW / 2}" y="${by}" width="${barW}" height="${Math.max(4, barH)}" rx="5" fill="url(#weekGrad)" opacity="0.95">
                                <title>${item.label}: ${hours} 小时</title>
                            </rect>
                            <text x="${cx}" y="${by - 6}" fill="var(--matrix-l4)" font-size="11" font-weight="bold" font-family="monospace" text-anchor="middle">${hours}h</text>
                            <text x="${cx}" y="${h - 8}" fill="currentColor" font-size="11" font-family="monospace" text-anchor="middle" class="text-neutral-400">${item.label}</text>
                        </g>
                    `;
                });
                svgHtml += `</svg>`;
                container.innerHTML = svgHtml;

            } else if (currentChartTab === "monthly") {
                if (caption) caption.textContent = "近 6 个月学时累计汇总 · 长期学业知识沉淀";
                const months = 6;
                const monthData: { label: string; mins: number }[] = [];
                const now = new Date();
                let maxMins = 3000;

                for (let m = months - 1; m >= 0; m--) {
                    const d = new Date(now.getFullYear(), now.getMonth() - m, 1);
                    const mStr = `${d.getFullYear()}-${(d.getMonth() + 1).toString().padStart(2, "0")}`;
                    let total = 0;
                    sessions.forEach((s) => {
                        if (s.date.startsWith(mStr)) total += s.durationMinutes;
                    });
                    if (total > maxMins) maxMins = total;
                    monthData.push({ label: `${d.getMonth() + 1}月`, mins: total });
                }

                const w = container.clientWidth || 600;
                const h = container.clientHeight || 260;
                const padL = 40, padR = 20, padT = 30, padB = 30;
                const plotW = w - padL - padR;
                const plotH = h - padT - padB;
                const barW = Math.max(26, Math.min(60, (plotW / 6) * 0.5));

                let svgHtml = `<svg width="100%" height="100%" viewBox="0 0 ${w} ${h}" class="overflow-visible select-none">
                    <defs>
                        <linearGradient id="monthGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--matrix-l3)" />
                            <stop offset="100%" stop-color="var(--matrix-l1)" />
                        </linearGradient>
                    </defs>
                `;
                monthData.forEach((item, idx) => {
                    const cx = padL + (idx + 0.5) * (plotW / 6);
                    const barH = (item.mins / maxMins) * plotH;
                    const by = padT + plotH - barH;
                    const hours = (item.mins / 60).toFixed(1);
                    svgHtml += `
                        <g class="cursor-pointer">
                            <rect class="bar-rect" x="${cx - barW / 2}" y="${by}" width="${barW}" height="${Math.max(4, barH)}" rx="6" fill="url(#monthGrad)" opacity="0.95">
                                <title>${item.label}: ${hours} 小时</title>
                            </rect>
                            <text x="${cx}" y="${by - 6}" fill="var(--matrix-l4)" font-size="11.5" font-weight="bold" font-family="monospace" text-anchor="middle">${hours}h</text>
                            <text x="${cx}" y="${h - 8}" fill="currentColor" font-size="11" font-family="monospace" text-anchor="middle" class="text-neutral-400">${item.label}</text>
                        </g>
                    `;
                });
                svgHtml += `</svg>`;
                container.innerHTML = svgHtml;

            } else if (currentChartTab === "subjects") {
                if (caption) caption.textContent = "各研习科目时间投入占比 · 均衡发展与重点攻坚";
                const subjMap = new Map<string, number>();
                let total = 0;
                sessions.forEach((s) => {
                    subjMap.set(s.subject, (subjMap.get(s.subject) || 0) + s.durationMinutes);
                    total += s.durationMinutes;
                });

                const sorted = Array.from(subjMap.entries()).sort((a, b) => b[1] - a[1]);
                const palette = ["var(--matrix-l4)", "var(--matrix-l3)", "var(--matrix-l2)", "var(--matrix-l1)", "#60a5fa", "#93c5fd"];

                let html = `<div class="h-full flex flex-col justify-center px-4">
                    <div class="w-full h-5 rounded-full overflow-hidden flex bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-6">`;
                sorted.forEach(([subj, mins], idx) => {
                    const pct = total > 0 ? ((mins / total) * 100).toFixed(1) : "0";
                    html += `<div style="width: ${pct}%; background-color: ${palette[idx % palette.length]};" title="${subj}: ${pct}%" class="h-full"></div>`;
                });
                html += `</div><div class="grid grid-cols-1 md:grid-cols-2 gap-3">`;
                sorted.forEach(([subj, mins], idx) => {
                    const pct = total > 0 ? ((mins / total) * 100).toFixed(1) : "0";
                    const hours = (mins / 60).toFixed(1);
                    html += `
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/5 dark:border-white/5 text-xs">
                            <div class="flex items-center gap-2 truncate">
                                <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: ${palette[idx % palette.length]};"></span>
                                <span class="font-medium text-black/80 dark:text-white/80 truncate">${subj}</span>
                            </div>
                            <div class="font-mono text-neutral-400 shrink-0">
                                <span class="font-bold text-black/90 dark:text-white/90 mr-1">${hours}h</span>
                                <span>(${pct}%)</span>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
                container.innerHTML = html;
            }
        }

        // 4. 渲染近期流水日志
        function renderLogs() {
            const tbody = document.getElementById("session-log-tbody");
            if (!tbody) return;
            tbody.innerHTML = "";
            const displayList = sessions.slice(0, 10);
            if (displayList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-neutral-400">当前筛选条件下暂无打卡记录，开启你的第一次专注吧！</td></tr>`;
                return;
            }
            displayList.forEach((s) => {
                const tr = document.createElement("tr");
                tr.className = "hover:bg-black/[0.02] dark:hover:bg-white/[0.02] transition-colors";
                tr.innerHTML = `
                    <td class="py-2.5 px-3 text-neutral-500 dark:text-neutral-400">${s.date} ${s.time}</td>
                    <td class="py-2.5 px-3 font-medium text-black/90 dark:text-white/90">${s.subject}</td>
                    <td class="py-2.5 px-3 font-bold text-blue-500">${s.durationMinutes} 分钟</td>
                    <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded text-[11px] bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">${s.mode}</span></td>
                    <td class="py-2.5 px-3 text-right">
                        <button data-id="${s.id}" class="btn-delete-sess text-neutral-400 hover:text-red-500 transition-colors cursor-pointer">删除</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        renderMetrics();
        renderHeatmap();
        renderCharts();
        renderLogs();
    }

    // ── 全局事件代理 (Event Delegation) 确保所有按键 100% 灵敏响应 ──
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        // 1. 开始/暂停计时按键
        const btnToggle = target.closest("#timer-btn-toggle");
        if (btnToggle) {
            e.preventDefault();
            if (TimerCore.running) {
                TimerCore.pause();
            } else {
                TimerCore.start();
            }
            return;
        }

        // 2. 结算打卡
        const btnSave = target.closest("#timer-btn-save");
        if (btnSave) {
            e.preventDefault();
            if (TimerCore.seconds < 15) {
                alert("专注时长未满 15 秒，继续加油吧！");
                return;
            }
            const mins = Math.max(1, Math.round(TimerCore.seconds / 60));
            const now = new Date();
            const dateStr = now.toISOString().split("T")[0];
            const timeStr = `${now.getHours().toString().padStart(2, "0")}:${now.getMinutes().toString().padStart(2, "0")}`;
            const subjectSelect = document.getElementById("timer-subject") as HTMLSelectElement | null;
            const subj = subjectSelect?.value || "综合研习";

            const sessions = getStoredSessions();
            sessions.unshift({
                id: `sess-${Date.now()}`,
                date: dateStr,
                time: timeStr,
                durationMinutes: mins,
                subject: subj,
                mode: TimerCore.mode === "pomodoro" ? "番茄专注" : "自由计时"
            });
            saveSessions(sessions);
            TimerCore.reset();
            mountStudyViews();
            return;
        }

        // 3. 重置计时器
        const btnReset = target.closest("#timer-btn-reset");
        if (btnReset) {
            e.preventDefault();
            TimerCore.reset();
            return;
        }

        // 4. 计时模式切换
        const btnModeStopwatch = target.closest("#mode-stopwatch");
        if (btnModeStopwatch) {
            e.preventDefault();
            if (TimerCore.mode === "stopwatch") return;
            TimerCore.reset();
            TimerCore.mode = "stopwatch";
            TimerCore.saveState();
            btnModeStopwatch.className = "px-3 py-1 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";
            const btnPomo = document.getElementById("mode-pomodoro");
            if (btnPomo) btnPomo.className = "px-3 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
            document.getElementById("pomo-duration-pills")?.classList.add("hidden");
            TimerCore.syncUI();
            return;
        }

        const btnModePomo = target.closest("#mode-pomodoro");
        if (btnModePomo) {
            e.preventDefault();
            if (TimerCore.mode === "pomodoro") return;
            TimerCore.reset();
            TimerCore.mode = "pomodoro";
            TimerCore.saveState();
            btnModePomo.className = "px-3 py-1 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";
            const btnSw = document.getElementById("mode-stopwatch");
            if (btnSw) btnSw.className = "px-3 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
            document.getElementById("pomo-duration-pills")?.classList.remove("hidden");
            TimerCore.syncUI();
            return;
        }

        // 5. 番茄预设时长
        const pomoPill = target.closest(".pomo-pill");
        if (pomoPill) {
            e.preventDefault();
            document.querySelectorAll(".pomo-pill").forEach((b) => {
                b.className = "pomo-pill px-2.5 py-1 text-xs rounded-md bg-black/5 dark:bg-white/5 text-neutral-500 hover:text-black dark:hover:text-white border border-transparent cursor-pointer";
            });
            pomoPill.className = "pomo-pill px-2.5 py-1 text-xs rounded-md bg-blue-500/20 text-blue-500 font-semibold border border-blue-500/40 cursor-pointer";
            const duration = Number(pomoPill.getAttribute("data-duration")) || 25;
            TimerCore.pomoTargetSeconds = duration * 60;
            TimerCore.reset();
            return;
        }

        // 6. 快捷补卡
        const btn30m = target.closest("#quick-add-30m");
        const btn1h = target.closest("#quick-add-1h");
        if (btn30m || btn1h) {
            e.preventDefault();
            const mins = btn1h ? 60 : 30;
            const now = new Date();
            const dateStr = now.toISOString().split("T")[0];
            const timeStr = `${now.getHours().toString().padStart(2, "0")}:${now.getMinutes().toString().padStart(2, "0")}`;
            const subjectSelect = document.getElementById("timer-subject") as HTMLSelectElement | null;
            const subj = subjectSelect?.value || "综合研习";

            const sessions = getStoredSessions();
            sessions.unshift({
                id: `quick-${Date.now()}`,
                date: dateStr,
                time: timeStr,
                durationMinutes: mins,
                subject: subj,
                mode: "快捷补卡"
            });
            saveSessions(sessions);
            mountStudyViews();
            return;
        }

        // 7. 恢复样例数据
        const btnResetSeed = target.closest("#reset-seed-data");
        if (btnResetSeed) {
            e.preventDefault();
            if (confirm("是否恢复为预设的学期完整打卡样例数据？")) {
                localStorage.removeItem(STORAGE_KEY);
                mountStudyViews();
            }
            return;
        }

        // 8. 顶部 Tab 切换 ([ 概览 ] [ 学科分布 ] [ 时段趋势 ])
        const viewTabBtn = target.closest(".ag-view-tab-btn");
        if (viewTabBtn) {
            e.preventDefault();
            const tab = viewTabBtn.getAttribute("data-view-tab") || "overview";
            document.querySelectorAll(".ag-view-tab-btn").forEach((b) => {
                b.className = "ag-view-tab-btn px-3.5 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
            });
            viewTabBtn.className = "ag-view-tab-btn px-3.5 py-1.5 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";

            if (tab === "overview") currentChartTab = "daily";
            else if (tab === "subjects") currentChartTab = "subjects";
            else if (tab === "trends") currentChartTab = "weekly";

            // 同步柱状图胶囊选中状态
            document.querySelectorAll(".chart-tab-btn").forEach((b) => {
                const bTab = b.getAttribute("data-tab");
                if (bTab === currentChartTab) {
                    b.className = "chart-tab-btn px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";
                } else {
                    b.className = "chart-tab-btn px-3 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
                }
            });

            mountStudyViews();
            return;
        }

        // 9. 时间范围筛选胶囊 ([ 全部 ] [ 30天 ] [ 7天 ])
        const rangePill = target.closest(".ag-range-pill");
        if (rangePill) {
            e.preventDefault();
            const range = rangePill.getAttribute("data-range-val") || "all";
            currentTimeRange = range;
            document.querySelectorAll(".ag-range-pill").forEach((b) => {
                b.className = "ag-range-pill px-2.5 py-1 rounded-md text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
            });
            rangePill.className = "ag-range-pill px-2.5 py-1 rounded-md bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";
            mountStudyViews();
            return;
        }

        // 10. 配色方案切换 (🌌 星轨蓝 / 🌿 极客绿)
        const btnPalette = target.closest("#ag-palette-toggle");
        if (btnPalette) {
            e.preventDefault();
            const current = localStorage.getItem(MATRIX_THEME_KEY) || "blue";
            const nextTheme = current === "blue" ? "green" : "blue";
            localStorage.setItem(MATRIX_THEME_KEY, nextTheme);
            initMatrixTheme();
            mountStudyViews();
            return;
        }

        // 11. 柱状图 Tab 切换
        const chartTabBtn = target.closest(".chart-tab-btn");
        if (chartTabBtn) {
            e.preventDefault();
            const tab = chartTabBtn.getAttribute("data-tab") || "daily";
            currentChartTab = tab;
            document.querySelectorAll(".chart-tab-btn").forEach((b) => {
                b.className = "chart-tab-btn px-3 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer";
            });
            chartTabBtn.className = "chart-tab-btn px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer";
            mountStudyViews();
            return;
        }

        // 12. 删除单条打卡记录
        const btnDel = target.closest(".btn-delete-sess");
        if (btnDel) {
            e.preventDefault();
            const sid = btnDel.getAttribute("data-id");
            if (sid && confirm("确定删除该条专注记录吗？")) {
                let sessions = getStoredSessions();
                sessions = sessions.filter((x) => x.id !== sid);
                saveSessions(sessions);
                mountStudyViews();
            }
            return;
        }
    });

    // 监听科目下拉筛选变更
    document.addEventListener("change", (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.id === "ag-filter-subject") {
            currentFilterSubject = (target as HTMLSelectElement).value;
            mountStudyViews();
        }
    });

    // 绑定生命周期：确保 Swup 切页与直达页面均能完美装载
    function tryMount() {
        if (window.location.pathname.includes("/study")) {
            mountStudyViews();
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", tryMount);
    } else {
        tryMount();
    }

    // @ts-ignore
    if (window.swup?.hooks) {
        // @ts-ignore
        window.swup.hooks.on("page:view", tryMount);
        // @ts-ignore
        window.swup.hooks.on("content:replace", tryMount);
    } else {
        document.addEventListener("swup:enable", () => {
            // @ts-ignore
            window.swup?.hooks?.on("page:view", tryMount);
            // @ts-ignore
            window.swup?.hooks?.on("content:replace", tryMount);
        });
    }

    window.addEventListener("resize", () => {
        if (window.location.pathname.includes("/study")) {
            mountStudyViews();
        }
    });
</script>
