---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="学研时序 · Antigravity 专注空间" description="接下来做什么，林睿轩 (ioio) ? 学研时序 · 专注计时与星轨活动分析">
    <!-- Antigravity 旗舰置顶问候语 (1:1 还原用户界面) -->
    <div class="flex items-center justify-between mb-4 onload-animation">
        <div class="flex items-center gap-2.5">
            <span class="text-blue-500 font-bold text-lg md:text-xl select-none">▲</span>
            <h1 class="text-xl md:text-2xl font-bold tracking-tight text-black/90 dark:text-white/90">
                接下来做什么，林睿轩 (ioio) ?
            </h1>
        </div>
        <!-- 引擎状态徽章 -->
        <div class="hidden sm:flex items-center gap-2">
            <span class="px-2.5 py-1 text-xs rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20 font-mono font-medium flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                <span>Gemini 3.8 Flash (High) 就绪</span>
            </span>
        </div>
    </div>

    <!-- 🌟 Antigravity 核心数据与星轨活动看板 (The Flagship Dashboard from Image 1 & 2) -->
    <div class="card-base p-5 md:p-7 rounded-2xl mb-6 onload-animation relative overflow-hidden" id="ag-dashboard-panel">
        <!-- 顶部导航 Tab 与右侧过滤工具栏 -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-5 border-b border-black/5 dark:border-white/10">
            <!-- 标签页切换：[ 概览 ] [ 学科分布 ] [ 时段趋势 ] -->
            <div class="inline-flex p-1 bg-black/5 dark:bg-white/5 rounded-xl border border-black/5 dark:border-white/10 text-xs font-medium">
                <button type="button" data-view-tab="overview" class="ag-view-tab-btn px-3.5 py-1.5 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer">
                    概览
                </button>
                <button type="button" data-view-tab="subjects" class="ag-view-tab-btn px-3.5 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                    学科分布
                </button>
                <button type="button" data-view-tab="trends" class="ag-view-tab-btn px-3.5 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                    时段趋势
                </button>
            </div>

            <!-- 右侧项目/时间范围筛选与配色切换 -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- 学科/项目下拉选择器 (图 1 中的 '全部项目 ▾') -->
                <select id="ag-filter-subject" class="px-2.5 py-1 text-xs rounded-lg bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-black/80 dark:text-white/80 focus:outline-none focus:border-blue-500 cursor-pointer transition-colors">
                    <option value="all">全部项目 / 科目</option>
                    <option value="人工智能数学方法">🧮 人工智能数学方法</option>
                    <option value="概率论与数理统计">📊 概率论与数理统计</option>
                    <option value="主成分分析 (PCA)">📉 主成分分析 (PCA)</option>
                    <option value="电路分析与信号">⚡ 电路分析与信号</option>
                    <option value="算法与编程工程">💻 算法与编程工程</option>
                    <option value="前沿学术论文研读">📖 学术论文研读</option>
                </select>

                <!-- 时间范围过滤 (图 1 中的 '全部' '30天' '7天') -->
                <div class="inline-flex p-0.5 bg-black/5 dark:bg-white/5 rounded-lg border border-black/5 dark:border-white/10 text-[11px] font-medium">
                    <button type="button" data-range-val="all" class="ag-range-pill px-2.5 py-1 rounded-md text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">全部</button>
                    <button type="button" data-range-val="30" class="ag-range-pill px-2.5 py-1 rounded-md bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer">30天</button>
                    <button type="button" data-range-val="7" class="ag-range-pill px-2.5 py-1 rounded-md text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">7天</button>
                </div>

                <!-- 配色切换: 🌌 蓝曜星轨 / 🌿 GitHub 绿 -->
                <button type="button" id="ag-palette-toggle" class="p-1.5 text-xs rounded-lg bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-neutral-500 hover:text-blue-500 transition-all cursor-pointer" title="切换星轨蓝 / GitHub 极客绿">
                    <span id="ag-palette-icon">🌌</span>
                </button>
            </div>
        </div>

        <!-- 6 项核心指标 HUD (3 列 x 2 行，1:1 还原图 1 中的 6 个指标卡) -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 md:gap-3 mb-5" id="ag-stats-hud">
            <!-- 1. 会话数 (专注打卡 Session 数量) -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">会话数</div>
                <div id="stat-sessions-count" class="text-xl md:text-2xl font-extrabold text-black/90 dark:text-white/90 font-mono">16</div>
            </div>

            <!-- 2. 消息数 (累计打卡频次/颗粒度记录) -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">打卡记录数</div>
                <div id="stat-total-records" class="text-xl md:text-2xl font-extrabold text-black/90 dark:text-white/90 font-mono">696</div>
            </div>

            <!-- 3. Token 总量 / 研习学时总量 -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">研习学时总量</div>
                <div class="flex items-baseline gap-1">
                    <span id="stat-total-hours" class="text-xl md:text-2xl font-extrabold text-blue-500 font-mono">146.5</span>
                    <span class="text-xs text-neutral-400 font-mono font-medium">h</span>
                </div>
            </div>

            <!-- 4. 活跃天数 -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">活跃天数</div>
                <div class="flex items-baseline gap-1">
                    <span id="stat-active-days" class="text-xl md:text-2xl font-extrabold text-black/90 dark:text-white/90 font-mono">9</span>
                    <span class="text-xs text-neutral-400 font-mono font-medium">天</span>
                </div>
            </div>

            <!-- 5. 缓存命中率 / 专注达标率 -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">习惯达标率</div>
                <div id="stat-target-rate" class="text-xl md:text-2xl font-extrabold text-black/90 dark:text-white/90 font-mono">90.1%</div>
            </div>

            <!-- 6. 最常用模型 / 最常研习科目 -->
            <div class="p-3.5 rounded-xl bg-black/[0.025] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] truncate">
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium mb-1">最常研习科目</div>
                <div id="stat-top-subject" class="text-xs md:text-sm font-bold text-black/90 dark:text-white/90 truncate font-mono mt-1">人工智能数学方法</div>
            </div>
        </div>

        <!-- 🌌 天体星轨活动矩阵卡片 (The Celestial Orbit Activity Matrix from Image 1 & 2!) -->
        <div class="relative rounded-xl p-4 md:p-5 bg-black/[0.02] dark:bg-[#0c0e14] border border-black/[0.06] dark:border-white/[0.08] overflow-hidden mb-5 select-none" id="orbit-matrix-card">
            <!-- 天体星轨 SVG 背景图层 (跨越整个矩阵视口，完美复刻图 2 中的椭圆、十字焦点与橙色行星) -->
            <svg id="orbital-svg" class="absolute inset-0 w-full h-full pointer-events-none z-0" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <defs>
                    <filter id="planet-glow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"/>
                        <feMerge>
                            <feMergeNode in="blur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                <!-- 椭圆星轨：虚线主轨道与细实线引力场 (完全按照图 2 的倾角与曲度呈现) -->
                <ellipse cx="44%" cy="48%" rx="48%" ry="45%" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.2" stroke-dasharray="4 4" class="dark:stroke-white/10 stroke-black/10"/>
                <ellipse cx="44%" cy="48%" rx="48%" ry="45%" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" class="dark:stroke-white/5 stroke-black/5"/>
                <!-- 轨道左侧十字焦点坐标 (+) (对应图 2 中间的十字刻度) -->
                <path d="M 190 60 L 190 70 M 185 65 L 195 65" stroke="rgba(255,255,255,0.22)" stroke-width="1" class="dark:stroke-white/25 stroke-black/20"/>
                <!-- 橙色轨道行星 / 探针 (带自发光辉光，复刻图 2 的金色亮点) -->
                <circle cx="73%" cy="64%" r="3.6" fill="#f59e0b" filter="url(#planet-glow)" class="ag-orbit-planet"/>
            </svg>

            <!-- 热力矩阵滚动层 (小方块网格，居于星轨上方，半透明小格子与星轨重叠产生深邃层次感) -->
            <div class="relative z-10 overflow-x-auto pb-2 scrollbar-thin">
                <div class="min-w-[700px] flex flex-col gap-2">
                    <!-- 月份标签行 -->
                    <div id="heatmap-months-header" class="flex text-[11px] text-neutral-400 pl-8 font-mono"></div>

                    <div class="flex gap-2">
                        <!-- 星期标签列 -->
                        <div class="flex flex-col justify-between text-[10px] text-neutral-400 font-mono py-0.5 w-6 shrink-0 select-none">
                            <span>周一</span>
                            <span>周三</span>
                            <span>周五</span>
                            <span>周日</span>
                        </div>

                        <!-- 核心小方块网格 (自适应蓝曜 / 极客绿) -->
                        <div id="heatmap-grid" class="flex gap-[3.5px]">
                            <!-- 由 JS 动态渲染周列和 7 天格子 -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- 底部妙趣横生比喻与像素吉祥物 (1:1 还原图 1 中的 '你的 Token 用量相当于 68 本《红楼梦》' 与右下角双像素宠物) -->
            <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 mt-3 border-t border-black/5 dark:border-white/5 text-xs text-neutral-400 font-mono">
                <div class="flex items-center gap-2">
                    <span id="ag-token-analogy" class="text-neutral-600 dark:text-neutral-300 font-medium">
                        你的 研习时长 相当于 68 本《红楼梦》（或攻克 150 道高难度数学推导题）。
                    </span>
                </div>

                <!-- 右侧像素伴学宠物与图例 (Orange Alien & Purple Cat from Antigravity) -->
                <div class="flex items-center gap-4 self-end sm:self-auto">
                    <!-- 热力深浅图例 -->
                    <div class="flex items-center gap-1.5 font-mono text-[10px]">
                        <span>少</span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l0)] border border-black/10 dark:border-white/5 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l1)] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l2)] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l3)] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l4)] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--matrix-l5)] inline-block"></span>
                        <span>多</span>
                    </div>

                    <!-- 两个可爱的 Antigravity 原生像素伴学吉祥物 (SVG Pixel Art) -->
                    <div class="flex items-center gap-2">
                        <!-- 橙色像素小恐龙/机器人 -->
                        <svg class="w-5 h-5 hover:scale-125 transition-transform cursor-pointer" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <title>Antigravity 橙色伴学小精灵</title>
                            <rect x="4" y="2" width="8" height="2" fill="#F97316"/>
                            <rect x="3" y="4" width="10" height="6" fill="#F97316"/>
                            <rect x="5" y="5" width="2" height="2" fill="#18181B"/>
                            <rect x="9" y="5" width="2" height="2" fill="#18181B"/>
                            <rect x="4" y="10" width="8" height="3" fill="#EA580C"/>
                            <rect x="3" y="13" width="3" height="3" fill="#C2410C"/>
                            <rect x="10" y="13" width="3" height="3" fill="#C2410C"/>
                        </svg>

                        <!-- 紫色像素小猫 -->
                        <svg class="w-5 h-5 hover:scale-125 transition-transform cursor-pointer" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <title>Antigravity 紫色伴学猫猫</title>
                            <rect x="2" y="3" width="3" height="3" fill="#A855F7"/>
                            <rect x="11" y="3" width="3" height="3" fill="#A855F7"/>
                            <rect x="4" y="5" width="8" height="6" fill="#A855F7"/>
                            <rect x="5" y="7" width="2" height="2" fill="#FAFAFA"/>
                            <rect x="9" y="7" width="2" height="2" fill="#FAFAFA"/>
                            <rect x="3" y="11" width="10" height="3" fill="#9333EA"/>
                            <rect x="4" y="14" width="2" height="2" fill="#7E22CE"/>
                            <rect x="10" y="14" width="2" height="2" fill="#7E22CE"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- 嵌入式实时专注计时控制台 (随时开启专注打卡，与看板紧密融合) -->
        <div class="pt-4 border-t border-black/5 dark:border-white/10 flex flex-col md:flex-row items-center justify-between gap-5">
            <div class="flex items-center gap-4 flex-wrap">
                <!-- 计时模式选择 -->
                <div class="inline-flex p-1 bg-black/5 dark:bg-white/5 rounded-xl border border-black/5 dark:border-white/10 text-xs font-medium">
                    <button type="button" id="mode-stopwatch" class="px-3 py-1 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm transition-all font-semibold cursor-pointer">
                        正向自由计时
                    </button>
                    <button type="button" id="mode-pomodoro" class="px-3 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                        番茄深度专注
                    </button>
                </div>

                <!-- 大数字时钟 -->
                <div class="flex items-center gap-2">
                    <div id="timer-display" class="font-mono text-3xl md:text-4xl font-extrabold tracking-tight text-black/90 dark:text-white/90 select-none">
                        00:00:00
                    </div>
                    <div id="timer-pulse-dot" class="w-2.5 h-2.5 rounded-full bg-blue-500 opacity-0 transition-opacity"></div>
                </div>

                <!-- 番茄预设时长胶囊 (番茄模式生效) -->
                <div id="pomo-duration-pills" class="hidden flex items-center gap-1.5">
                    <button type="button" data-duration="25" class="pomo-pill px-2.5 py-1 text-xs rounded-md bg-blue-500/20 text-blue-500 font-semibold border border-blue-500/40 cursor-pointer">25m</button>
                    <button type="button" data-duration="45" class="pomo-pill px-2.5 py-1 text-xs rounded-md bg-black/5 dark:bg-white/5 text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer">45m</button>
                    <button type="button" data-duration="60" class="pomo-pill px-2.5 py-1 text-xs rounded-md bg-black/5 dark:bg-white/5 text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer">60m</button>
                </div>
            </div>

            <div class="flex items-center gap-2.5 w-full md:w-auto justify-end flex-wrap">
                <!-- 研习科目选择 -->
                <select id="timer-subject" class="px-3 py-1.5 text-xs md:text-sm rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-black/90 dark:text-white/90 focus:outline-none focus:border-blue-500 transition-all cursor-pointer">
                    <option value="人工智能数学方法">🧮 人工智能数学方法</option>
                    <option value="概率论与数理统计">📊 概率论与数理统计</option>
                    <option value="主成分分析 (PCA)">📉 主成分分析 (PCA)</option>
                    <option value="电路分析与信号">⚡ 电路分析与电子工程</option>
                    <option value="算法与编程工程">💻 算法逻辑与代码开发</option>
                    <option value="前沿学术论文研读">📖 学术论文与专业文献</option>
                    <option value="期末/综合复习备考">🎯 综合复习与例题精研</option>
                </select>

                <!-- 核心控制按钮 -->
                <button type="button" id="timer-btn-toggle" class="px-5 py-2 rounded-xl font-bold text-xs md:text-sm bg-blue-500 text-white hover:brightness-110 active:scale-95 transition-all shadow-md shadow-blue-500/25 flex items-center gap-1.5 cursor-pointer">
                    <svg id="timer-icon-play" class="w-3.5 h-3.5 fill-current pointer-events-none" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <svg id="timer-icon-pause" class="w-3.5 h-3.5 fill-current hidden pointer-events-none" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    <span id="timer-btn-text" class="pointer-events-none">开始专注</span>
                </button>

                <button type="button" id="timer-btn-save" class="px-3.5 py-2 rounded-xl font-semibold text-xs md:text-sm bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 text-neutral-700 dark:text-neutral-300 border border-black/10 dark:border-white/10 transition-all disabled:opacity-40 disabled:pointer-events-none cursor-pointer" disabled>
                    结算打卡
                </button>

                <!-- 快捷补卡 -->
                <button type="button" id="quick-add-30m" class="px-2.5 py-2 text-xs font-medium rounded-xl bg-black/5 dark:bg-white/5 hover:bg-blue-500/10 hover:text-blue-500 border border-black/10 dark:border-white/10 transition-all cursor-pointer" title="补卡 30 分钟">
                    +30m
                </button>
                <button type="button" id="quick-add-1h" class="px-2.5 py-2 text-xs font-medium rounded-xl bg-blue-500/10 text-blue-500 hover:bg-blue-500/20 border border-blue-500/20 transition-all font-semibold cursor-pointer" title="补卡 1 小时">
                    +1h
                </button>

                <button type="button" id="timer-btn-reset" class="p-2 rounded-xl text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 hover:bg-black/5 dark:hover:bg-white/5 transition-all cursor-pointer" title="重置计时器">
                    <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- 按天、按周、按月多维柱状图分析卡片 (Daily / Weekly / Monthly Charts) -->
    <div class="card-base p-6 md:p-8 rounded-2xl mb-6 onload-animation">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-2.5 h-2.5 rounded-full bg-blue-500"></div>
                <h2 class="text-base md:text-lg font-bold text-black/90 dark:text-white/90">
                    时序研习时长多维分析 (柱状图与趋势)
                </h2>
            </div>

            <!-- 分析维度切换胶囊 -->
            <div class="inline-flex p-1 bg-black/5 dark:bg-white/5 rounded-xl border border-black/5 dark:border-white/10 text-xs font-medium">
                <button type="button" data-tab="daily" class="chart-tab-btn px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-sm font-semibold transition-all cursor-pointer">
                    近 14 天每日柱状
                </button>
                <button type="button" data-tab="weekly" class="chart-tab-btn px-3 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                    近 8 周累计
                </button>
                <button type="button" data-tab="monthly" class="chart-tab-btn px-3 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                    近 6 个月汇总
                </button>
                <button type="button" data-tab="subjects" class="chart-tab-btn px-3 py-1.5 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white transition-all cursor-pointer">
                    学科分布
                </button>
            </div>
        </div>

        <!-- 柱状图主渲染视口 (纯原生 SVG + CSS，零第三方库，0ms 阻塞加载) -->
        <div id="chart-container" class="relative w-full h-64 md:h-72">
            <!-- 由 JS 动态绘制 -->
        </div>

        <!-- 底部注解 -->
        <div id="chart-caption" class="text-xs text-neutral-400 mt-4 text-center font-mono">
            标线刻度：日均目标 3.0 小时 · 柱体颜色深浅依据专注时长动态渐变
        </div>
    </div>

    <!-- 最近学习记录明细流水 -->
    <div class="card-base p-6 md:p-8 rounded-2xl mb-8 onload-animation">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <div class="flex items-center gap-2">
                <div class="w-1.5 h-5 bg-blue-500 rounded-full"></div>
                <h2 class="text-base md:text-lg font-bold text-black/90 dark:text-white/90">
                    近期研习打卡记录
                </h2>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-neutral-400">本地离线存储 · 刷新不丢失</span>
                <button type="button" id="reset-seed-data" class="px-2.5 py-1 text-xs rounded-lg text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 bg-black/5 dark:bg-white/5 transition-all cursor-pointer" title="恢复为预设的学期完整样本数据">
                    ↺ 恢复样例数据
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs md:text-sm">
                <thead>
                    <tr class="border-b border-black/5 dark:border-white/10 text-neutral-400 font-medium">
                        <th class="py-2.5 px-3">日期与时间</th>
                        <th class="py-2.5 px-3">研习科目</th>
                        <th class="py-2.5 px-3">投入时长</th>
                        <th class="py-2.5 px-3">模式</th>
                        <th class="py-2.5 px-3 text-right">操作</th>
                    </tr>
                </thead>
                <tbody id="session-log-tbody" class="divide-y divide-black/5 dark:divide-white/5 font-mono">
                    <!-- 动态记录行 -->
                </tbody>
            </table>
        </div>
    </div>
</MainGridLayout>

<!-- 悬停气泡 Tooltip (全局单例) -->
<div id="gh-tooltip" class="fixed pointer-events-none z-50 px-3 py-1.5 rounded-lg text-xs bg-neutral-900/95 text-white border border-white/15 shadow-xl backdrop-blur-md opacity-0 transition-opacity duration-150 -translate-x-1/2 -translate-y-full mb-2">
    <div id="gh-tooltip-date" class="font-bold text-[11px] text-neutral-300"></div>
    <div id="gh-tooltip-content" class="text-xs text-blue-400 font-semibold mt-0.5"></div>
</div>

<style>
    /* Antigravity 蓝曜星轨配色方案 (默认与图 1、图 2 保持一致) */
    :root {
        --matrix-l0: #eef2f6;
        --matrix-l1: #bfdbfe;
        --matrix-l2: #60a5fa;
        --matrix-l3: #3b82f6;
        --matrix-l4: #2563eb;
        --matrix-l5: #1d4ed8;
        --matrix-glow: rgba(59, 130, 246, 0.4);
    }
    :root.dark,
    :root[data-prism-preset="obsidian-dark"],
    :root[data-prism-preset="warm-dark"],
    :root[data-prism-preset="classic-dark"] {
        --matrix-l0: #12151d;
        --matrix-l1: #1e293b;
        --matrix-l2: #2563eb;
        --matrix-l3: #3b82f6;
        --matrix-l4: #60a5fa;
        --matrix-l5: #93c5fd;
        --matrix-glow: rgba(59, 130, 246, 0.45);
    }

    /* GitHub 极客绿配色方案 (当切换至绿曜模式时生效) */
    :root[data-matrix-theme="green"] {
        --matrix-l0: #ebedf0;
        --matrix-l1: #9be9a8;
        --matrix-l2: #40c463;
        --matrix-l3: #30a14e;
        --matrix-l4: #216e39;
        --matrix-l5: #14532d;
        --matrix-glow: rgba(48, 161, 78, 0.35);
    }
    :root.dark[data-matrix-theme="green"],
    :root[data-prism-preset="obsidian-dark"][data-matrix-theme="green"],
    :root[data-prism-preset="warm-dark"][data-matrix-theme="green"],
    :root[data-prism-preset="classic-dark"][data-matrix-theme="green"] {
        --matrix-l0: #161b22;
        --matrix-l1: #0e4429;
        --matrix-l2: #006d32;
        --matrix-l3: #26a641;
        --matrix-l4: #39d353;
        --matrix-l5: #56ff74;
        --matrix-glow: rgba(57, 211, 83, 0.4);
    }

    /* 热力图方块微光过渡 */
    .gh-cell {
        width: 12px;
        height: 12px;
        border-radius: 2.8px;
        transition: transform 0.12s ease, outline 0.12s ease;
        contain: layout style;
