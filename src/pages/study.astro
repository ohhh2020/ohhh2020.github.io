    .gh-cell:hover {
        transform: scale(1.35);
        outline: 1.5px solid var(--matrix-l4);
        z-index: 20;
        box-shadow: 0 0 8px var(--matrix-glow);
    }

    /* 天体行星发光脉冲动画 */
    @keyframes orbitPulse {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0 0 4px #f59e0b);
        }
        50% {
            transform: scale(1.25);
            filter: drop-shadow(0 0 10px #fbbf24);
        }
