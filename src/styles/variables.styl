  --enter-btn-bg var(--btn-regular-bg)
  --enter-btn-bg-hover var(--btn-regular-bg-hover)
  --enter-btn-bg-active var(--btn-regular-bg-active)

  --line-divider rgba(245, 240, 230, 0.08)
  --line-color rgba(245, 240, 230, 0.1)
  --meta-divider rgba(245, 240, 230, 0.2)

  --inline-code-bg rgba(245, 240, 230, 0.065)
  --inline-code-color #E59377
  --selection-bg rgba(217, 119, 87, 0.32)
  --codeblock-selection rgba(217, 119, 87, 0.35)
  --codeblock-bg #0F0E0D
  --codeblock-topbar-bg rgba(245, 240, 230, 0.03)
  --license-block-bg #0F0E0D

  --specular-color rgba(255, 248, 236, 0.08)
  --elevation-1 inset 0 1px 0 rgba(255, 248, 236, 0.08), 0 0 0 0.5px rgba(0, 0, 0, 0.46), 0 2px 4px rgba(0, 0, 0, 0.3), 0 8px 20px -6px rgba(0, 0, 0, 0.45)
