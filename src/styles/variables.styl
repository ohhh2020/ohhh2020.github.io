  --btn-regular-bg-active rgba(245, 240, 230, 0.15)

  --btn-plain-bg-hover rgba(245, 240, 230, 0.055)
  --btn-plain-bg-active rgba(245, 240, 230, 0.095)

  --btn-card-bg-hover rgba(245, 240, 230, 0.04)
