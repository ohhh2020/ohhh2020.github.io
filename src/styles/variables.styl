  --btn-plain-bg-hover rgba(42, 32, 20, 0.05)
  --btn-plain-bg-active rgba(194, 89, 52, 0.085)

  --btn-card-bg-hover rgba(42, 32, 20, 0.025)
  --btn-card-bg-active rgba(42, 32, 20, 0.055)

  --enter-btn-bg var(--btn-regular-bg)
  --enter-btn-bg-hover var(--btn-regular-bg-hover)
  --enter-btn-bg-active var(--btn-regular-bg-active)

  --line-divider rgba(42, 32, 20, 0.08)
  --line-color rgba(42, 32, 20, 0.1)
  --meta-divider rgba(42, 32, 20, 0.15)

