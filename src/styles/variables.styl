  --admonitions-color-important #A882DD
  --admonitions-color-warning #E5A93B
  --admonitions-color-caution #E5534B

  --toc-badge-bg rgba(217, 119, 87, 0.15)
  --toc-btn-hover rgba(245, 240, 230, 0.055)
  --toc-btn-active rgba(245, 240, 230, 0.095)
  --toc-item-active #D97757

