  --btn-card-bg-hover rgba(15, 23, 42, 0.025)
  --btn-card-bg-active rgba(15, 23, 42, 0.055)

  --enter-btn-bg var(--btn-regular-bg)
  --enter-btn-bg-hover var(--btn-regular-bg-hover)
  --enter-btn-bg-active var(--btn-regular-bg-active)

  --line-divider rgba(15, 23, 42, 0.08)
  --line-color rgba(15, 23, 42, 0.1)
  --meta-divider rgba(15, 23, 42, 0.15)

