/* ==========================================================================
   Obsidian Prism Design Tokens & Optical Palettes for Fuwari Astro Blog
   Flagship 4-Preset System:
   1. 深空黑曜 (obsidian-dark) - 冷调钛黑 · 旗舰高对比
   2. 暖炭玄岩 (warm-dark)     - 玄武岩炭 · 夜间柔和
   3. 白昼冷晶 (daylight-crystal) - 高明度冰蓝 · 现代明色
   4. 暖白画册 (warm-alabaster)   - 纸墨暖白 · 印刷品书卷
   ========================================================================== */

/* Concentric micro-bevel radius & timing */
:root
  --radius-large 0.5rem
  --radius-medium 0.375rem
  --radius-small 0.25rem
  --content-delay 150ms
  --toc-width calc((100vw - var(--page-width)) / 2 - 1rem)
  --ag-prism-cobalt #4c8df6
  --ag-prism-iris #9b72cb
  --ag-prism-coral #d96570
  --ag-prism-amber #f2b84b

/* ── 1. 深空黑曜 (Obsidian Dark · 默认暗色旗舰) ─────────────────────── */
:root[data-prism-preset="obsidian-dark"],
:root.dark:not([data-prism-preset]),
:root[data-prism-preset="obsidian-dark"].dark
  color-scheme dark
  --page-bg #0E0E11
  --card-bg rgba(20, 20, 24, 0.85)
  --card-border rgba(255, 255, 255, 0.088)
  --float-panel-bg rgba(20, 21, 26, 0.95)
  --ag-v2-ripple-ink rgb(146, 148, 156)
  --ag-v2-ripple-wave rgb(214, 218, 228)

  --foreground #F2F2F5
  --secondary-foreground #C4C4CE
  --muted-foreground #8A8A98
  --deep-text #F2F2F5

  --primary #669DF6
  --primary-soft rgba(102, 157, 246, 0.14)
  --primary-border rgba(102, 157, 246, 0.38)
  --link #8AB4F8
  --link-underline rgba(102, 157, 246, 0.35)
  --link-hover #8AB4F8
  --link-active #669DF6
  --title-active #8AB4F8

  --btn-content #669DF6
  --btn-regular-bg rgba(255, 255, 255, 0.06)
  --btn-regular-bg-hover rgba(255, 255, 255, 0.10)
  --btn-regular-bg-active rgba(255, 255, 255, 0.14)

  --btn-plain-bg-hover rgba(255, 255, 255, 0.055)
  --btn-plain-bg-active rgba(255, 255, 255, 0.095)

  --btn-card-bg-hover rgba(255, 255, 255, 0.04)
  --btn-card-bg-active rgba(255, 255, 255, 0.08)

  --enter-btn-bg var(--btn-regular-bg)
  --enter-btn-bg-hover var(--btn-regular-bg-hover)
  --enter-btn-bg-active var(--btn-regular-bg-active)

  --line-divider rgba(255, 255, 255, 0.08)
  --line-color rgba(255, 255, 255, 0.1)
  --meta-divider rgba(255, 255, 255, 0.2)

  --inline-code-bg rgba(255, 255, 255, 0.06)
  --inline-code-color #8AB4F8
  --selection-bg rgba(102, 157, 246, 0.32)
  --codeblock-selection rgba(102, 157, 246, 0.35)
  --codeblock-bg #09090B
  --codeblock-topbar-bg rgba(255, 255, 255, 0.03)
  --license-block-bg #09090B

  --specular-color rgba(255, 255, 255, 0.095)
  --elevation-1 inset 0 1px 0 rgba(255, 255, 255, 0.095), 0 0 0 0.5px rgba(0, 0, 0, 0.42), 0 2px 4px rgba(0, 0, 0, 0.3), 0 8px 20px -6px rgba(0, 0, 0, 0.45)
  --elevation-2 inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.5), 0 4px 8px rgba(0, 0, 0, 0.35), 0 14px 28px -6px rgba(0, 0, 0, 0.55)

  --scrollbar-bg rgba(255, 255, 255, 0.18)
  --scrollbar-bg-hover rgba(255, 255, 255, 0.32)
  --scrollbar-bg-active rgba(255, 255, 255, 0.45)

  --color-selection-bar linear-gradient(to right, #4285F4, #9B72CB, #EA4335, #FBBC04)
  --display-light-icon 0
  --display-dark-icon 1

  --admonitions-color-note #669DF6
  --admonitions-color-tip #50A37B
  --admonitions-color-important #9B72CB
  --admonitions-color-warning #F2B84B
  --admonitions-color-caution #E5534B

  --toc-badge-bg rgba(102, 157, 246, 0.15)
  --toc-btn-hover rgba(255, 255, 255, 0.055)
  --toc-btn-active rgba(255, 255, 255, 0.095)
  --toc-item-active #669DF6

/* ── 2. 暖炭玄岩 (Warm Dark · 护眼夜间微暖) ────────────────────────── */
